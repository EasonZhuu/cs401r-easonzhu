#!/usr/bin/env bash
# Windows/Git Bash-compatible replacement for awscli-local.
# All requests go to the LocalStack endpoint, never to real AWS.

export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_DEFAULT_REGION="${DEFAULT_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}"

exec aws --endpoint-url="http://${LOCALSTACK_HOST:-localhost}:4566" "$@"
