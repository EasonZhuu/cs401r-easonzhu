{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3BucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "S3DataReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "${bucket_arn}/raw/*",
        "${bucket_arn}/processed/*",
        "${bucket_arn}/features/*"
      ]
    },
    {
      "Sid": "FeatureStoreObjectAcl",
      "Effect": "Allow",
      "Action": "s3:PutObjectAcl",
      "Resource": "${bucket_arn}/features/*"
    },
    {
      "Sid": "GlueScriptsReadOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${bucket_arn}/artifacts/glue/*"
    },
    {
      "Sid": "GlueCatalogMetadata",
      "Effect": "Allow",
      "Action": [
        "glue:CreateDatabase",
        "glue:GetDatabase",
        "glue:UpdateDatabase",
        "glue:CreateTable",
        "glue:GetTable",
        "glue:GetTables",
        "glue:UpdateTable",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:UpdatePartition"
      ],
      "Resource": [
        "arn:aws:glue:${region}:${account_id}:catalog",
        "arn:aws:glue:${region}:${account_id}:database/${database_name}",
        "arn:aws:glue:${region}:${account_id}:table/${database_name}/*"
      ]
    },
    {
      "Sid": "GluePipelines",
      "Effect": "Allow",
      "Action": [
        "glue:CreateJob",
        "glue:GetJob",
        "glue:UpdateJob",
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:BatchStopJobRun",
        "glue:GetCrawler",
        "glue:UpdateCrawler",
        "glue:StartCrawler",
        "glue:StopCrawler",
        "glue:GetConnection",
        "glue:GetConnections",
        "glue:GetUsageProfile",
        "glue:GetTags",
        "glue:TagResource"
      ],
      "Resource": [
        "arn:aws:glue:${region}:${account_id}:catalog",
        "arn:aws:glue:${region}:${account_id}:database/${database_name}",
        "arn:aws:glue:${region}:${account_id}:crawler/${name_prefix}-raw-crawler",
        "arn:aws:glue:${region}:${account_id}:job/${name_prefix}-transform",
        "arn:aws:glue:${region}:${account_id}:job/${name_prefix}-feature-engineer",
        "arn:aws:glue:${region}:${account_id}:connection/${name_prefix}-*",
        "arn:aws:glue:${region}:${account_id}:usageProfile/${name_prefix}-*"
      ]
    },
    {
      "Sid": "GlueActionsWithoutResourceScoping",
      "Effect": "Allow",
      "Action": [
        "glue:CreateCrawler",
        "glue:GetJobBookmark"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FeatureStoreWrite",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateFeatureGroup",
        "sagemaker:DescribeFeatureGroup",
        "sagemaker:PutRecord",
        "sagemaker:AddTags"
      ],
      "Resource": "arn:aws:sagemaker:${region}:${account_id}:feature-group/${name_prefix}-customer-features"
    },
    {
      "Sid": "PassOwnRoleToPipelineServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "${data_engineer_role_arn}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "glue.amazonaws.com",
            "sagemaker.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadOwnRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies"
      ],
      "Resource": "${data_engineer_role_arn}"
    },
    {
      "Sid": "GlueVpcDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeRouteTables",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueVpcAttributes",
      "Effect": "Allow",
      "Action": "ec2:DescribeVpcAttribute",
      "Resource": "arn:aws:ec2:${region}:${account_id}:vpc/*"
    },
    {
      "Sid": "GlueNetworkInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${account_id}:network-interface/*",
        "arn:aws:ec2:${region}:${account_id}:subnet/*",
        "arn:aws:ec2:${region}:${account_id}:security-group/*"
      ]
    },
    {
      "Sid": "GlueNetworkInterfaceTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:${region}:${account_id}:network-interface/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "aws-glue-service-resource"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    },
    {
      "Sid": "PipelineLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${region}:${account_id}:log-group:/aws-glue/*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/${name_prefix}-*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/sagemaker/*"
      ]
    }
  ]
}
